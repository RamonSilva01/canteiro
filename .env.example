# Copie para .env.local e preencha. Valores em Supabase > Project Settings > API Keys.
# Só contas pessoais: nenhuma credencial da Contourline aqui.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# "Publishable key" (sb_publishable_...). Pode ir ao navegador: quem protege o dado é a RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...). IGNORA a RLS. Só servidor, nunca commitar.
SUPABASE_SECRET_KEY=

# F2 (classificação e leitura de nota por IA). Conta própria na Anthropic.
ANTHROPIC_API_KEY=
